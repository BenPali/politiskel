# /etc/politiskel/politiskel.env — read by politiskel.service.
# Readable by root and the service only: sudo chmod 640, group politiskel.

# Where the service listens: localhost only, the proxy is in front.
POLITISKEL_ADDR=127.0.0.1:8080

# The SQLite database (created on first start, migrated on every start).
POLITISKEL_DB=/var/lib/politiskel/politiskel.db

# The page, as built by `node tools/extract.js` (template.html).
POLITISKEL_PAGE=/opt/politiskel/template.html

# Behind a reverse proxy: take the client's address from X-Forwarded-For,
# so the sign-in and sign-up limits count per visitor, not per proxy.
POLITISKEL_TRUST_PROXY=1

# The public address. Needed when the proxy does not pass the Host header
# through; harmless otherwise.
POLITISKEL_ORIGIN=https://politiskel.example.org

# `invite`: accounts only from a group's invitation link (the very first
# account is always allowed). `open`: anyone who reaches the site.
POLITISKEL_SIGNUP=invite
