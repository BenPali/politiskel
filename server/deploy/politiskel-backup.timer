# Runs politiskel-backup.service once a day.
#
#   sudo cp politiskel-backup.service politiskel-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now politiskel-backup.timer

[Unit]
Description=Daily Politiskel database backup

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
