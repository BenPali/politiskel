# Politiskel group server, as a systemd service.
#
#   sudo cp politiskel.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now politiskel
#
# It runs as its own unprivileged user, can write only its database
# directory, and listens on localhost: the reverse proxy in front terminates
# HTTPS. Settings live in /etc/politiskel/politiskel.env (see the example).

[Unit]
Description=Politiskel group server
After=network.target

[Service]
User=politiskel
Group=politiskel
EnvironmentFile=/etc/politiskel/politiskel.env
ExecStart=/opt/politiskel/politiskel-server
WorkingDirectory=/var/lib/politiskel
Restart=on-failure
RestartSec=2

# Hardening: nothing of the system is writable but the database directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/politiskel
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
